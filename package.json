{
  "name": "dreamhost-vscode",
  "displayName": "DreamDeploy",
  "description": "Deploy to DreamHost from VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dreamdeploy-sidebar",
          "title": "DreamDeploy",
          "icon": "$(cloud-upload)"
        }
      ]
    },
    "views": {
      "dreamdeploy-sidebar": [
        {
          "type": "webview",
          "id": "dreamdeploy.sidebarView",
          "name": "DreamDeploy"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "build": "npm run compile && npm run build:webview",
    "build:webview": "cd webview-ui && npm run build",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
